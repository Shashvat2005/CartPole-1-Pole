<mujoco model="cartpole">
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <visual>
    <global offwidth="640" offheight="480" azimuth="90" elevation="-5"/>
  </visual>

  <worldbody>
    <light pos="0 -3 4" dir="0 0.6 -0.8"/>
    <geom name="floor" type="plane" size="6 1 0.1" pos="0 0 -0.8" rgba="0.85 0.85 0.85 1"/>

    <!-- rail the cart slides along (visual only, no collisions) -->
    <geom name="rail" type="capsule" fromto="-2.5 0 0 2.5 0 0" size="0.01"
          rgba="0.3 0.3 0.3 1" contype="0" conaffinity="0"/>

    <!-- cart: slides along x -->
    <body name="cart" pos="0 0 0">
      <joint name="slider" type="slide" axis="1 0 0" limited="true" range="-2.4 2.4" damping="0.05"/>
      <geom name="cart_geom" type="box" size="0.2 0.1 0.08" rgba="0.2 0.4 0.8 1" mass="1"/>

      <!-- pole: hinge about y, starts pointing up (+z) -->
      <body name="pole" pos="0 0 0">
        <joint name="hinge" type="hinge" axis="0 1 0" damping="0.002"/>
        <geom name="pole_geom" type="capsule" fromto="0 0 0 0 0 0.6" size="0.02"
              rgba="0.9 0.3 0.2 1" mass="0.1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- force on the cart, +-10 N -->
    <motor name="push" joint="slider" gear="1" ctrllimited="true" ctrlrange="-10 10"/>
  </actuator>

  <!-- starting pose with a small tilt: qpos = [cart_x, pole_angle] -->
  <keyframe>
    <key name="tilted" qpos="0 0.05"/>
  </keyframe>
</mujoco>
